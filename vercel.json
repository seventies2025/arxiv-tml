{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    {
      "src": "/api/arxiv/(.*)",
      "dest": "https://export.arxiv.org/api/$1"
    },
    {
      "src": "/@vite/client",
      "status": 404
    },
    {
      "src": "/styles.css",
      "headers": {
        "Content-Type": "text/css; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "/app.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "api/index.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
