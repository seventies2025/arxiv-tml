{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    {
      "src": "/api/arxiv/(.*)",
      "dest": "https://export.arxiv.org/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
