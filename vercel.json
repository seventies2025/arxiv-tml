{
  "version": 2,
  "builds": [
    {
      "src": "api/topic.mjs",
      "use": "@vercel/edge"
    },
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/api/topic",
      "dest": "api/topic.mjs"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}